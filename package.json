{
  "name": "esl-article-scaffolder",
  "version": "1.0.0",
  "description": "Turn an article into leveled ESL reading packs (K, Grade 5, Grade 10) with glossary and questions.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "debug-server": "node --inspect --watch server/index.js",
    "test": "node --test \"test/*.test.js\"",
    "format": "prettier --write \"server/**/*.js\" \"public/**/*.{js,css,html}\" \"test/*.js\""
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "docx": "^9.11.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "obscenity": "^0.4.6",
    "pdf-parse": "^2.4.5",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  },
  "private": true,
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
